# Host Module Federation remotes
VITE_MFE_STUDENT_URL=http://localhost:4173
VITE_MFE_INSTITUTION_URL=http://localhost:4175
VITE_MFE_ACTIVITY_URL=http://localhost:4176
VITE_MFE_DASHBOARD_URL=http://localhost:4178
VITE_MFE_ADMIN_URL=http://localhost:4179

# Runtime API configuration used by MFEs
VITE_API_URL=http://localhost:3333

# Supabase Auth (use project URL and anon/public key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend OIDC verification (set OIDC_ISSUER from the Supabase project URL)
OIDC_ISSUER=
OIDC_AUDIENCE=authenticated

# Sentry (org: fidelis) — one project per package. Set VITE_SENTRY_DSN in each package's
# own environment (packages/<name>/.env.local locally, project env vars in Vercel):
#   host -> mfe-host | mfe-student | mfe-activity | mfe-institution | mfe-dashboard | mfe-admin
# Leave empty to disable Sentry. Optional: VITE_SENTRY_RELEASE (e.g. the git SHA).
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# Sentry source maps (build-time only, never expose to the browser). Create an org auth token
# in Sentry (Settings > Developer Settings) and set it as a secret in CI / Vercel. When unset,
# builds skip source map generation and upload.
SENTRY_AUTH_TOKEN=
