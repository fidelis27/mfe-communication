{
  "name": "@mfe/shared",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.cpSync('src/ui','dist/ui',{recursive:true,filter:(source)=>fs.statSync(source).isDirectory()||source.endsWith('.css')})\""
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/react": "^18.2.0",
    "zod": "^4.6.7"
  }
}
