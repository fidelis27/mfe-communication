{
  "name": "secretaria-escolar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "modules/frontend/packages/*"
  ],
  "scripts": {
    "pretest": "npm run build --workspace=@mfe/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:dev": "ts-node server/index.en.ts",
    "dev:local": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-local.ps1",
    "validate:local": "powershell -ExecutionPolicy Bypass -File ./scripts/validate-local.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.17",
    "@types/node": "^22.20.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
